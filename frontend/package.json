{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "rxd:test": "node --experimental-strip-types --test ../rxd-robot-evaluator/tests/validate-evaluations.test.ts",
    "rxd:schemas": "node ../rxd-robot-evaluator/scripts/generate-schemas.mjs",
    "images:check": "node scripts/publish-images.mjs",
    "images:publish": "node scripts/publish-images.mjs --publish",
    "images:connection": "node scripts/check-r2.mjs",
    "dev": "next dev",
    "predev": "node scripts/translate-content.mjs sync",
    "prebuild": "node scripts/translate-content.mjs sync",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "jobs:check": "node scripts/publish-jobs.mjs --check",
    "jobs:publish:dry": "node scripts/publish-jobs.mjs --dry-run",
    "jobs:publish": "node scripts/publish-jobs.mjs",
    "audio:dry": "node scripts/article-audio.mjs --dry-run",
    "audio:publish": "node scripts/article-audio.mjs",
    "audio:test": "node --test scripts/article-audio.test.mjs",
    "translate": "node scripts/translate-content.mjs",
    "translate:check": "node scripts/translate-content.mjs check",
    "translate:test": "node --test scripts/translation.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "@therobotage/ui": "*",
    "bootstrap": "^5.3.8",
    "framer-motion": "^12.38.0",
    "gray-matter": "^4.0.3",
    "leaflet": "^1.9.4",
    "marked": "^18.0.2",
    "media-chrome": "^4.19.2",
    "next": "16.2.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "resend": "^6.12.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/js-yaml": "^4.0.9",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "js-yaml": "^4.3.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "webmcp-types": "^0.1.5"
  }
}
