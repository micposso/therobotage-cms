# Copy to .env.local and fill in. .env* is gitignored.

# ── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://therobotage.com
NEXT_PUBLIC_LMS_URL=https://learn.therobotage.com
# Set to "true" on staging only. Blocks every crawler from the whole site.
SITE_NOINDEX=

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM_HELLO=hello@therobotage.com
EMAIL_FROM_RESEARCH=research@therobotage.com
# Job board sender. Needs DKIM/SPF verified in Resend before any digest goes out.
EMAIL_FROM_JOBS=jobs@send.therobotage.com
RESEND_AUDIENCE_ID=

# ── Job board (Supabase) ─────────────────────────────────────────────────────
# Shares the LMS Supabase project. Reads use the publishable key and are limited by
# RLS to live listings.
#
# NEXT_PUBLIC_SUPABASE_URL must be available at BUILD time as well as runtime:
# generateStaticParams on /jobs/[slug] and the sitemap both query at build.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# JWT for the scoped jobs_alert_service Postgres role (see
# lms/supabase/migrations/00022_create_jobs_service_role.sql), used by
# getSupabaseJobsService() -- subscribe/unsubscribe, the alert cron, and the
# expired-job fallback read. This is NOT the project's service_role key: it has no
# bypassrls and can only touch the jobs/companies/*taxonomy* tables plus
# job_alert_subscribers and job_alert_sends. Never set this to the LMS's
# SUPABASE_SERVICE_ROLE_KEY -- that key bypasses RLS on every table in the shared
# project, including LMS student data.
SUPABASE_JOBS_SERVICE_KEY=

# Local/CI only -- scripts/publish-jobs.mjs writes to jobs and companies directly and
# needs the project's real service-role key. Never set this on the deployed frontend
# service; the app itself only needs SUPABASE_JOBS_SERVICE_KEY above.
SUPABASE_SERVICE_ROLE_KEY=

# ── Job alerts ───────────────────────────────────────────────────────────────
# Shared secret for /api/cron/job-alerts and /api/revalidate-jobs.
CRON_SECRET=
# Which UTC weekday the digest sends. 0=Sunday ... 2=Tuesday (default).
JOB_ALERT_SEND_DAY=2
# BCC address for welcome mail and digest run reports.
JOB_ALERT_ADMIN_EMAIL=
# Salt for hashing signup IPs. Raw IPs are never stored.
JOB_ALERT_IP_SALT=
# Physical postal address for the CAN-SPAM footer on bulk email. Required before the
# first digest send.
MAILING_ADDRESS=

# ── Content tooling ──────────────────────────────────────────────────────────
# Black Forest Labs key, used by the publish-article skill for image generation.
BFL_API_KEY=
