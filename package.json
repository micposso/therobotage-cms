{
  "name": "therobotage",
  "private": true,
  "workspaces": [
    "frontend",
    "lms",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n cms,web -c magenta,cyan \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "dev:cms": "npm run develop --prefix backend",
    "dev:web": "npm run dev --prefix frontend",
    "dev:lms": "npm run dev --prefix lms"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
